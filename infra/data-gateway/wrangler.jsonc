{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crt-data-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "r2_buckets": [
    {
      "binding": "CRT_DATA",
      "bucket_name": "freddie-mac-crt-disclosure-data"
    }
  ]
}
